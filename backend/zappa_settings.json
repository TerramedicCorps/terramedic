{
  "base": {
    "aws_region": "us-east-1",
    "django_settings": "terramedic.core.settings",
    "project_name": "terramedic",
    "s3_bucket": "terramedic-prod-zappa-deployments",
    "runtime": "python3.14",
    "vpc_config": {
      "SubnetIds": [],
      "SecurityGroupIds": []
    },
    "manage_roles": false,
    "role_name": "terramedic-prod-zappa-deployment",
    "timeout_seconds": 30,
    "slim_handler": false,
    "use_precompiled_packages": false,
    "environment_variables": {
      "IS_LAMBDA": "true",
      "GDAL_DATA": "/opt/share/gdal",
      "PROJ_LIB": "/opt/share/proj",
      "LD_LIBRARY_PATH": "/opt/lib:/opt/lib64"
    },
    "exclude": [
      "*.gz",
      "*.rar",
      "*.zip",
      "*.tar",
      ".git/*",
      "tests/*",
      "*.pyc",
      "docker/*",
      "scripts/*",
      "node_modules/*",
      ".pytest_cache/*",
      "__pycache__/*",
      "*.egg-info/*",
      ".coverage",
      "htmlcov/*"
    ],
    "cors": true,
    "cors_allow_headers": [
      "Content-Type",
      "X-CSRFToken",
      "Authorization",
      "X-Requested-With",
      "Accept-Language"
    ],
    "apigateway_settings": {
      "throttle_burst_limit": 100,
      "throttle_rate_limit": 50
    }
  },
  "dev": {
    "extends": "base",
    "stage": "dev",
    "docker_image": "public.ecr.aws/lambda/python:3.14",
    "memory_size": 512,
    "keep_warm": false,
    "environment_variables": {
      "IS_LAMBDA": "true",
      "GDAL_DATA": "/opt/share/gdal",
      "PROJ_LIB": "/opt/share/proj",
      "LD_LIBRARY_PATH": "/opt/lib:/opt/lib64",
      "ENVIRONMENT": "development",
      "DEBUG": "false"
    },
    "aws_environment_variables": {
      "DATABASE_URL": "",
      "SECRET_KEY": ""
    },
    "xray_tracing": false
  },
  "prod": {
    "extends": "base",
    "stage": "prod",
    "docker_image": "public.ecr.aws/lambda/python:3.14",
    "memory_size": 1024,
    "keep_warm": true,
    "keep_warm_expression": "rate(4 minutes)",
    "environment_variables": {
      "IS_LAMBDA": "true",
      "GDAL_DATA": "/opt/share/gdal",
      "PROJ_LIB": "/opt/share/proj",
      "LD_LIBRARY_PATH": "/opt/lib:/opt/lib64",
      "ENVIRONMENT": "production",
      "DEBUG": "false"
    },
    "aws_environment_variables": {
      "DATABASE_URL": "",
      "SECRET_KEY": ""
    },
    "xray_tracing": true
  }
}
