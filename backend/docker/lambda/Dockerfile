# Application image for AWS Lambda deployment
# Uses the geolambda base image with GDAL/GEOS/PROJ pre-installed
ARG ECR_REGISTRY
FROM ${ECR_REGISTRY}/geolambda:3.12.2 AS app

WORKDIR /var/task

# Install Poetry, use it to install dependencies, then remove it
COPY pyproject.toml poetry.lock ./
RUN pip install --no-cache-dir poetry==2.1.3 && \
    poetry config virtualenvs.create false && \
    poetry install --only main --no-root --no-interaction --no-ansi && \
    pip uninstall -y poetry

# Copy application code
COPY terramedic/ ./terramedic/
COPY manage.py ./
COPY handler.py ./

# Copy Zappa settings (generated by configure_zappa.py in CI)
COPY zappa_settings.json ./

# Set Python path and library paths
ENV PYTHONPATH=/var/task:$PYTHONPATH \
    DJANGO_SETTINGS_MODULE=terramedic.core.settings \
    LD_LIBRARY_PATH=/opt/lib:/opt/lib64

# Collect static files into the image (survives cold starts)
# SECRET_KEY is needed for settings.py but not used by collectstatic
RUN mkdir -p /var/task/staticfiles && \
    SECRET_KEY=build-only-dummy-key python manage.py collectstatic --noinput

# Pre-compile Python files for faster cold starts
RUN python -m compileall -b terramedic

# Lambda handler
CMD ["zappa.handler.lambda_handler"]
